        "RP": {"name": "Rheinland-Pfalz", "gesetz": "Bildungsfreistellungsgesetz (BFG)", "tage": 10, "jahre": 2, "frist_wochen": 6, "wartezeit_monate": 6, "kleinbetrieb": "In Betrieben mit weniger als fünf Beschäftigten besteht kein Rechtsanspruch.", "klein_ausschluss_unter": 5, "klein_pruefen_bis": null},
        "SL": {"name": "Saarland", "gesetz": "Saarländisches Bildungsfreistellungsgesetz (SBFG)", "tage": 5, "jahre": 1, "frist_wochen": 6, "wartezeit_monate": 6, "kleinbetrieb": "In Arbeitsstätten mit weniger als zehn Beschäftigten kann abgelehnt werden, wenn mehr als ein Drittel der Beschäftigten den Anspruch bereits geltend gemacht hat.", "klein_ausschluss_unter": null, "klein_pruefen_bis": 9},
