        "MV": {"name": "Mecklenburg-Vorpommern", "gesetz": "Bildungsfreistellungsgesetz M-V (BfG M-V)", "tage": 10, "jahre": 2, "frist_wochen": 8, "wartezeit_monate": 6, "kleinbetrieb": null, "klein_ausschluss_unter": null, "klein_pruefen_bis": null},
        "NI": {"name": "Niedersachsen", "gesetz": "Niedersächsisches Bildungsurlaubsgesetz (NBildUG)", "tage": 5, "jahre": 1, "frist_wochen": 4, "wartezeit_monate": 6, "kleinbetrieb": "Ablehnung möglich, wenn die gewährten Freistellungstage das 2,5-Fache der am 30. April berechtigten Beschäftigten übersteigen.", "klein_ausschluss_unter": null, "klein_pruefen_bis": null},
